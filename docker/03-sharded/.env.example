# Parametri dello stack 03 — sharded cluster a due profili.
#
# Copiare in `.env` accanto a compose.yaml e modificare. Come nello stack 02 il
# file NON è facoltativo: la password dell'amministratore non ha un valore
# predefinito e senza `.env` l'avvio si ferma dicendolo.
#
# `.env` è ignorato da git (`.gitignore`), `.env.example` no. È la ragione per cui
# la password sta nel primo e un segnaposto vuoto nel secondo: nessuna
# credenziale entra nel repository, nemmeno una da laboratorio.
#
# DOVE VIVE `.env`. Nel checkout principale, non in un worktree (ADR-0056). Un
# file ignorato dentro un worktree è invisibile a `git status` e viene cancellato
# in silenzio da `git worktree remove`: è già successo, ed è costato la password
# di un lab a un `cp` di distanza dal non esistere più.

# L'immagine, pinnata per digest. NON si scrive a mano: si legge da
# tools/images.env, generato da `make images-pull`. I target del Makefile lo
# passano già con --env-file, quindi di norma questa riga non serve.
# MONGO_IMAGE=mongo@sha256:...

# PULL_POLICY non esiste: `pull_policy: never` è scritto fisso nel file Compose e
# non si sovrascrive da qui (ADR-0039). Se l'avvio fallisce dicendo che l'immagine
# manca, la risposta è `make images-pull`, una volta, con la rete.

# --- Identità dei replica set ----------------------------------------------

# Il nome del replica set dei config server. DEVE differire dal nome di ogni
# shard (ADR-0010): non è una convenzione, è un requisito. Cambiandolo qui va
# cambiato anche dentro la stringa `--configdb` di mongos, che lo nomina.
NOME_REPLICA_CFG=cfgrs

# I nomi dei due replica set di shard. Differiscono fra loro e da `cfgrs`, per lo
# stesso requisito. Compaiono nella scena del Blocco 3: `sh.status()` li stampa, e
# il pubblico deve poter dire a colpo d'occhio quale documento sta su quale shard.
NOME_REPLICA_SHARD1=shard1rs
NOME_REPLICA_SHARD2=shard2rs

# --- Chi sta in quale replica set ------------------------------------------
#
# LE TRE RIGHE PIÙ DELICATE DEL FILE. Dicono agli script di inizializzazione
# quali membri mettere in ciascun set, e DEVONO essere coerenti con il profilo
# che si avvia.
#
# I valori qui sotto sono quelli del profilo `palco`: un membro per componente.
# Per `--profile completo` vanno scommentate le tre righe della coppia successiva
# e commentate queste. `make up-03` lo fa da sé passando le variabili; chi lancia
# `docker compose` a mano no, ed è il caso per cui esiste la guardia.
#
# PERCHÉ UNA VARIABILE E NON IL PROFILO. Un servizio di inizializzazione non può
# dichiarare `depends_on` verso un membro che esiste solo in `completo`: Compose
# rifiuta l'intero progetto. La misura è in V-053, la conseguenza è che il numero
# di membri deve arrivare da fuori.
#
# COSA SUCCEDE SE SI SBAGLIA. Niente di silenzioso, ed è stato costruito apposta.
# Elencare più membri di quanti ne girano ferma l'avvio con il nome del membro che
# non risponde; elencarne meno — il caso pericoloso, perché di suo non fallirebbe
# affatto — ferma l'avvio con il nome del container di troppo.
MEMBRI_CFG=cfg1:27017
MEMBRI_SHARD1=shard1a:27017
MEMBRI_SHARD2=shard2a:27017

# Per `--profile completo`:
# MEMBRI_CFG=cfg1:27017,cfg2:27017,cfg3:27017
# MEMBRI_SHARD1=shard1a:27017,shard1b:27017,shard1c:27017
# MEMBRI_SHARD2=shard2a:27017,shard2b:27017,shard2c:27017
#
# Sono NOMI DI SERVIZIO Compose con la porta INTERNA 27017, mai le porte
# pubblicate qui sotto: è così che i membri si raggiungono fra loro, ed è così che
# finiscono scritti nella configurazione del set (ADR-0021).

# --- Porte sull'host -------------------------------------------------------

# Dalla mappa del design §5.2. `make preflight` controlla che siano libere prima
# del talk. Sono diverse da quelle degli altri due stack apposta: il 01 e il 02
# devono poter restare accesi mentre questo gira.
#
# Attenzione: cambiare una porta qui cambia solo come si raggiunge il membro
# DALL'HOST. Dentro il cluster i membri restano registrati come `cfg1:27017` e
# compagni, perché è così che si vedono fra loro sulla rete Compose. Nello
# sharded cluster la differenza morde due volte, perché quei nomi finiscono anche
# nel config server via `sh.addShard()` e tornano al client quando scopre la
# topologia (ADR-0021).
PORTA_CFG_1=27131
PORTA_CFG_2=27132
PORTA_CFG_3=27133

# I membri dei due shard. Il primo di ogni serie esiste in entrambi i profili, gli
# altri due solo in `completo`: con `palco` le porte 27142, 27143, 27152 e 27153
# restano libere perché i container non esistono, non perché siano state escluse.
PORTA_SHARD1_A=27141
PORTA_SHARD1_B=27142
PORTA_SHARD1_C=27143
PORTA_SHARD2_A=27151
PORTA_SHARD2_B=27152
PORTA_SHARD2_C=27153

# I due router. 27117 è LA porta del lab: è quella che si scrive nelle stringhe
# di connessione mostrate dal vivo, quella che usa lo smoke test, e quella a cui
# si collegherà l'applicazione Python di feature/04. Un client non parla mai a
# uno shard direttamente.
#
# 27118 è il secondo router, che esiste solo nel profilo `completo`. Serve a
# mostrare che i router sono più d'uno e intercambiabili: si ferma il primo, si
# continua sul secondo, e il cluster non se ne accorge.
PORTA_MONGOS=27117
PORTA_MONGOS_2=27118

# --- Risorse per config server ---------------------------------------------

# 512 MiB e 0,5 CPU ciascuno, dal bilancio del design §5.1. Meno dei 640 MiB di un
# membro di shard perché i metadati sono pochi: nomi di collezioni e intervalli di
# chunk, non documenti.
#
# La cache di WiredTiger resta fissa a 0,25 GiB nel file Compose e NON si cambia
# da qui. Chi alza la memoria non deve fare niente; chi la abbassa sotto i 256 MiB
# configura una cache più grande della memoria disponibile, e mongod accetta senza
# un avviso. `make stack-check` se ne accorge al posto nostro (ADR-0004).
MEMORIA_CFG=512m
CPU_CFG=0.5

# --- Risorse per i membri di shard ------------------------------------------

# 640 MiB e 0,5 CPU ciascuno. Più di un config server perché qui ci stanno i
# documenti. Valgono per tutti e sei i membri: due shard uguali fra loro, e nel
# profilo `palco` i membri in piedi sono due.
#
# Il conto del `palco` è quello che deve reggere in sala: 512 + 640 + 640 più
# `mongos`, ben dentro il bilancio del design §5.1. Con `completo` si moltiplica
# per tre, e da lì nasce la ragione dei due profili.
MEMORIA_SHARD=640m
CPU_SHARD=0.5

# --- Risorse per i router ---------------------------------------------------

# 256 MiB, la voce più economica del bilancio. `mongos` non tiene dati: tiene la
# mappa dei chunk e le connessioni verso gli shard. È il motivo per cui nel
# profilo `completo` due router stanno in piedi senza pesare.
MEMORIA_MONGOS=256m
CPU_MONGOS=0.5

# --- Credenziali dell'amministratore ---------------------------------------

# Le usano TRE servizi di inizializzazione, non uno: `cfg-init` crea con queste
# l'amministratore del cluster sul config server, e i due `shard*-init` creano con
# le stesse un amministratore locale a ciascuno shard. Tutti e tre subito dopo
# `rs.initiate()`, sotto eccezione localhost (ADR-0026, ADR-0040, ADR-0071). Da lì
# in poi servono a ogni connessione: mongosh, gli script di verifica,
# `sh.addShard()`, l'applicazione Python.
#
# UNA SOLA PASSWORD PER QUATTRO UTENTI È UNA SEMPLIFICAZIONE DI LABORATORIO. Il
# manuale vuole credenziali distinte per il cluster e per ogni shard, digitate a
# `passwordPrompt()` e mai scritte in un file. Perché qui si fa diversamente, e
# che cosa si fa invece in un'installazione vera, è in
# `docs/03-amministrazione/sicurezza-keyfile-x509.md` §4.2.

# L'utente ha un valore predefinito perché non è un segreto: è il nome che compare
# nelle stringhe di connessione mostrate dal vivo.
UTENTE_AMMINISTRATORE=admin

# La password NO, e la riga qui sotto è vuota di proposito.
#
# Per Compose una variabile vuota vale quanto una assente, quindi la forma
# `${PASSWORD_AMMINISTRATORE:?...}` nel file Compose fa fallire l'avvio con un
# messaggio invece di creare un utente con password vuota. Chi copia questo file
# in `.env` senza leggerlo se ne accorge al primo `up`, che è il momento giusto.
#
# Sono credenziali da LABORATORIO, su uno stack che non va esposto fuori dalla
# macchina di chi presenta: qui una password semplice è accettabile. Ciò che non è
# accettabile è che stia in un file versionato, dove sopravvive alla demo e finisce
# copiata altrove insieme al resto.
PASSWORD_AMMINISTRATORE=
