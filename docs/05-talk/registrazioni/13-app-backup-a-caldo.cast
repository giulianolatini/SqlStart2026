{"version": 2, "width": 100, "height": 30, "timestamp": 1788688005, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "feature/04 — mongolab demo backup-live: mongodump sotto carico, dal secondario (Blocco 2, Atto III)"}
[0.2975, "o", "backup a caldo da mongo-rs-1 · carico in lab.carico-20260906-114646\r\n  docker compose --env-file tools/images.env --env-file docker/02-replicaset/.env -f docker/02-replicaset/compose.yaml exec -T mongo-rs-1 mongodump --host rs0/mongo-rs-1:27017,mongo-rs-2:27017,mongo-rs-3:27017 --out /tmp/mongolab-backup --username admin --authenticationDatabase admin --readPreference=secondary --oplog\r\n"]
